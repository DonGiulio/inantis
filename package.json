{
  "name": "inantis",
  "version": "0.1.3",
  "description": "Local browser-based review of coding agent changes",
  "keywords": ["pi-package", "code-review", "agent-skills"],
  "files": ["dist", "src", "extensions", "vite.config.ts", "tsconfig.server.json", "skills", "plugin.json", ".claude-plugin", ".agents/plugins"],
  "pi": {
    "skills": ["./skills"]
  },
  "omp": {
    "extensions": ["./extensions/omp.mjs"]
  },
  "type": "module",
  "bin": {
    "inantis": "./dist/server/cli.js"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json",
    "prepare": "npm run build",
    "start": "node dist/server/cli.js",
    "dev": "concurrently -k -n server,web \"tsx watch src/server/cli.ts --dev\" \"vite --host 127.0.0.1 --port 5173 --strictPort --open\"",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "fastify": "^5.3.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^14.1.0",
    "open": "^10.1.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^10.0.7",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.2.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
